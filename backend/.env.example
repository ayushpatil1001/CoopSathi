# ====================================================================
# CoopSathi AI - Backend Environment Configuration (Template)
# ====================================================================

PORT=5000

# Security & CORS Whitelist Configuration
NODE_ENV=production
ALLOWED_ORIGINS=https://coopsathi.vercel.app

# Google Gemini API Configuration (Real-Time LLM Model)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Active Provider: official_gov_rag | bhashini | gemini_gov_rag
GOV_LLM_PROVIDER=official_gov_rag
