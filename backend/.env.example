# ====================================================================
# CoopSathi AI - Backend Environment Configuration (Template)
# ====================================================================

PORT=5000

# Security & CORS Whitelist Configuration
NODE_ENV=production
ALLOWED_ORIGINS=https://coopsathi.vercel.app

# Google Gemini API Configuration (Real-Time LLM Model)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Active Provider: official_gov_rag | bhashini | gemini_gov_rag
GOV_LLM_PROVIDER=official_gov_rag

# Digital India Bhashini (National Language Translation Mission - MeitY)
# 1. Udyat Key (ULCA partner API key)
BHASHINI_UDYAT_KEY=your_udyat_key_here
# 2. Inference Key (Dhruva compute authorization key)
BHASHINI_INFERENCE_KEY=your_inference_key_here
# Bhashini User ID (Registered email / UserID on Bhashini)
BHASHINI_USER_ID=your_user_id_here
# Legacy alias
BHASHINI_API_KEY=
